rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /usernames/{usernameLower} {
      // Deliberately world-readable: the sign-up form has to answer "is this
      // handle free?" before anyone is signed in, and publicProfiles is closed
      // to signed-out visitors. A document here holds only the uid that claimed
      // the handle — no email, no name, nothing personal.
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);

      // A handle can only be released or re-pointed by the account holding it.
      allow update, delete: if isAdmin() || resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      // The community feed is shared: every signed-in learner reads the same
      // collection, which is what makes one account's post appear on another's.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600
        && request.resource.data.likes == 0
        && request.resource.data.likedBy.size() == 0;

      // Authors may edit their own post. Everyone else may only move the
      // reaction fields — never the text, the author or the level.
      allow update: if isAdmin()
        || resource.data.uid == request.auth.uid
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likes', 'likedBy', 'reposts', 'repostedBy',
                           'comments']));

      allow delete: if isAdmin() || resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        // Replies are part of the shared feed, so anyone signed in can read
        // them; writing one is limited to the account it is attributed to.
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 400;

        allow update, delete: if isAdmin()
          || resource.data.uid == request.auth.uid;
      }
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if isAdmin()
        || resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid;

      allow update: if isAdmin()
        || resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid;

      allow delete: if isAdmin()
        || resource.data.fromUid == request.auth.uid;
    }

    match /ai_feedback_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /content_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
